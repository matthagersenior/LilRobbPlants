{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lil-robb-plants-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://matthagersenior.github.io"
  }
}
