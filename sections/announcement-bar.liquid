{% if section.settings.text != blank %}
  <div class="announcement" role="region" aria-label="Store announcement">
    <div class="page-width announcement__inner">
      {% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{% endif %}
        {{ section.settings.text | escape }}
      {% if section.settings.link != blank %}</a>{% endif %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Coming soon: Online ordering is not open yet. Browse the launch collection now." },
    { "type": "url", "id": "link", "label": "Optional link" }
  ]
}
{% endschema %}
