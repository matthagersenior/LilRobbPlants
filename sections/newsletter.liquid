<section class="section newsletter-section">
  <div class="page-width newsletter-card leaf-edge">
    <div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.text | escape }}</p></div>
    {% form 'customer', class: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="NewsletterEmail-{{ section.id }}">Email address</label>
      <div class="field-row"><input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required placeholder="you@example.com"><button class="button" type="submit">Join the list</button></div>
      {% if form.posted_successfully? %}<p class="form-message" role="status">Thanks for joining.</p>{% endif %}
      {% if form.errors %}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New plants, without the clutter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hear when fresh inventory lands." },
    { "type": "text", "id": "text", "label": "Text", "default": "Share your email for store updates you choose to send." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
