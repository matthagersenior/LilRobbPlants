<section class="section section--soft">
  <div class="page-width">
    <div class="section-heading"><h2>{{ section.settings.heading | escape }}</h2></div>
    <div class="category-grid">
      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}
        <article class="category-card leaf-edge" {{ block.shopify_attributes }}>
          <a href="{{ collection.url | default: routes.all_products_collection_url }}">
            <div class="category-card__media">
              {% if collection.featured_image != blank %}
                {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 768px) 33vw, 100vw', alt: collection.title }}
              {% elsif collection.products.first.featured_image != blank %}
                {{ collection.products.first.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 768px) 33vw, 100vw', alt: collection.title }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </div>
            <div class="category-card__body"><h3>{{ collection.title | default: block.settings.fallback_title | escape }}</h3><span class="text-link">Browse plants</span></div>
          </a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Plant categories",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Shop by what your space needs" }],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "fallback_title", "label": "Placeholder title", "default": "Plant collection" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Plant categories", "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }] }]
}
{% endschema %}
