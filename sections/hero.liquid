<section class="section section--hero">
  <div class="page-width hero leaf-edge">
    <div class="hero__content">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h1>{{ section.settings.heading | escape }}</h1>
      <div class="rte hero__text">{{ section.settings.text }}</div>
      {% if section.settings.button_label != blank %}<a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{% endif %}
    </div>
    <div class="hero__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 768px) 48vw, 100vw', alt: section.settings.image.alt }}
      {% else %}
        <img class="hero__brand-image" src="https://cdn.shopify.com/s/files/1/0748/8480/8855/files/the-robb-store-logo.webp?v=1789067987" alt="The Robb Store botanical logo" width="1200" height="800" loading="eager">
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Plant hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Grown for real homes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the right plant for your space." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Browse clear care details, live availability, and straightforward pricing before you buy.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop plants" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [{ "name": "Plant hero" }]
}
{% endschema %}
