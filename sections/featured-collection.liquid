{% liquid
  assign featured_collection = section.settings.collection
  if featured_collection == blank
    assign featured_collection = collections['launch-collection']
  endif
  if featured_collection == blank
    assign featured_collection = collections['all']
  endif
  assign has_representative_images = false
  if featured_collection != blank
    for item in featured_collection.products
      if item.tags contains 'Representative image'
        assign has_representative_images = true
        break
      endif
    endfor
  endif
%}
<section class="section" id="shop">
  <div class="page-width">
    <div class="section-heading">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
      {% if featured_collection != blank %}<a class="text-link" href="{{ featured_collection.url }}">View all</a>{% endif %}
    </div>
    {% if has_representative_images %}
      <p class="image-disclosure"><strong>Image notice:</strong> Representative images are used for the launch catalog. Actual plants may vary in size, shape, leaf pattern, pot, and appearance.</p>
    {% endif %}
    {% if featured_collection != blank and featured_collection.products_count > 0 %}
      <div class="product-grid">
        {% for product in featured_collection.products limit: section.settings.products_to_show %}
          {% render 'plant-card', product: product %}
        {% endfor %}
      </div>
    {% else %}
      <div class="empty-state"><h3>No plants featured yet</h3><p>Choose a collection in the theme editor after products are added.</p></div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured plants",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Launch collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Popular houseplants" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 10 }
  ],
  "presets": [{ "name": "Featured plants" }]
}
{% endschema %}
