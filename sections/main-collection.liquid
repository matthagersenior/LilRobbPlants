<section class="section">
  <div class="page-width">
    <div class="collection-header">
      <div>
        <p class="eyebrow">Shop plants</p>
        <h1>{{ collection.title | escape }}</h1>
        {% if collection.description != blank %}<div class="rte collection-description">{{ collection.description }}</div>{% endif %}
      </div>
      <form class="sort-form" action="{{ collection.url }}" method="get">
        <label for="SortBy-{{ section.id }}">Sort by</label>
        <select id="SortBy-{{ section.id }}" name="sort_by" onchange="this.form.submit()">
          {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
          {% for option in collection.sort_options %}<option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>{% endfor %}
        </select>
      </form>
    </div>
    {% paginate collection.products by section.settings.products_per_page %}
      {% if collection.products_count > 0 %}
        <div class="product-grid">{% for product in collection.products %}{% render 'plant-card', product: product %}{% endfor %}</div>
        {% if paginate.pages > 1 %}<nav class="pagination" aria-label="Collection pages">{{ paginate | default_pagination }}</nav>{% endif %}
      {% else %}
        <div class="empty-state"><h2>No plants in this collection yet</h2><p>Check another collection or come back after inventory is added.</p><a class="button button--secondary" href="{{ routes.all_products_collection_url }}">Shop all plants</a></div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Collection products",
  "settings": [
    { "type": "range", "id": "products_per_page", "min": 8, "max": 32, "step": 4, "label": "Products per page", "default": 16 }
  ]
}
{% endschema %}
